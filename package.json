{
  "name": "personal-agent-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "dev": "npm run build && NODE_ENV=development AUTH_MODE=disabled node --watch dist/server/index.js"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.4",
    "@ag-ui/core": "^1.0.4",
    "@ag-ui/encoder": "^1.0.4",
    "@assistant-ui/react": "^0.15.33",
    "@assistant-ui/react-ag-ui": "^0.1.2",
    "@assistant-ui/react-markdown": "^0.14.25",
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fastify": "^5.6.2",
    "jose": "^6.1.2",
    "lucide-react": "^1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "shadcn": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
