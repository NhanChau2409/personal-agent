NODE_ENV=development
PORT=3000
AUTH_MODE=disabled
PUBLIC_ORIGIN=http://127.0.0.1:3000
OWNER_EMAIL=owner@example.com
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-me
PI_AGENT_DIR=./runtime/pi-agent
PI_CODING_AGENT_DIR=./runtime/pi-agent
PI_WORKSPACE=./runtime/workspace
PI_PROVIDER=openai-codex
PI_MODEL=gpt-6.1-sol
PI_THINKING=low
# Optional one-account Google Workspace integration (Tasks, Calendar, Drive, Docs, Sheets).
# Use a separate OAuth web client from Cloudflare Access.
# Authorized redirect URI: https://agent.nhanchau.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32; keep this key safe or encrypted account tokens cannot be recovered.
GOOGLE_TOKEN_KEY=
GOOGLE_TOKEN_STORE=./runtime/pi-agent/google-accounts.json
# Optional: Brave Search API key (not a Brave Premium/YouTube subscription).
BRAVE_API_KEY=
